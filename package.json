{
  "name": "corotum",
  "version": "0.6.0",
  "private": true,
  "description": "Keep your agent skills in sync.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:cli": "./scripts/build-cli.sh bun-darwin-arm64",
    "build:cli:darwin-arm64": "./scripts/build-cli.sh bun-darwin-arm64",
    "build:cli:darwin-x64": "./scripts/build-cli.sh bun-darwin-x64",
    "build:cli:linux": "./scripts/build-cli.sh bun-linux-x64",
    "build:cli:linux-arm64": "./scripts/build-cli.sh bun-linux-arm64",
    "build:cli:linux-x64": "./scripts/build-cli.sh bun-linux-x64",
    "build:cli:windows-x64": "./scripts/build-cli.sh bun-windows-x64",
    "release:build": "bun ./tooling/release-build.ts",
    "release:upload": "bun ./tooling/release-upload.ts",
    "release:verify": "bun ./tooling/release-verify.ts",
    "release:deploy": "bun ./tooling/release-deploy.ts",
    "release:smoke-installers": "bun ./tooling/release-installer-smoke.ts",
    "release:smoke-endpoints": "bun ./tooling/release-endpoints.ts",
    "test:installers": "bun test ./tooling/installers.test.ts",
    "test:cli-update": "bun test ./apps/cli/src/cli-update.test.ts",
    "db:migrate": "bun run --cwd apps/web db:migrate",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "web:smoke": "bun run --cwd apps/web smoke",
    "check:boundaries": "bun ./scripts/check-architecture-boundaries.mjs",
    "check:skills-security": "bun ./scripts/check-skills-refactor-security.mjs",
    "lint": "bun run check:boundaries && bunx biome check .",
    "docs:check": "bun ./tooling/docs-check.ts",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "test:e2e": "bun ./tooling/test-e2e.ts",
    "test:cli:invalid-target": "! ./scripts/build-cli.sh bun-invalid-x64",
    "typecheck": "bunx tsc --noEmit",
    "verify:cli": "./scripts/verify-cli.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "playwright": "1.56.1",
    "portless": "^0.15.6",
    "typescript": "5.9.3"
  }
}
