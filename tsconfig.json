{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": [
    "tooling/**/*.ts",
    "apps/cli/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/shared/src/**/*.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
