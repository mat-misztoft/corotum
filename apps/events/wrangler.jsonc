{
  "$schema": "../web/node_modules/wrangler/config-schema.json",
  "name": "corotum-events",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-26",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACES", "class_name": "WorkspaceEvents" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceEvents"] }],
  "observability": { "enabled": true }
}
