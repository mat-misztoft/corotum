{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corotum-web",
  "compatibility_date": "2026-03-26",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "BETTER_AUTH_URL": "https://corotum.com",
    "COROTUM_ENVIRONMENT": "production",
    "COROTUM_HOSTED": "true",
    "AUTH_EMAIL_FROM": "auth@corotum.com"
  },
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "corotum"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corotum",
      "database_id": "c985f7b4-f3d9-47d1-89b2-b898ad18c1c6",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["auth@corotum.com"]
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "COROTUM_TELEMETRY",
      "dataset": "corotum_telemetry"
    }
  ]
}
